# Almanak KeeperGate — copy to .env (never commit .env)
#
# LIVE KeeperHub path (optional). When unset, the full CHP flow still runs
# and emits a clearly labeled MOCK execution record. Nothing is broadcast.
# Create an org key at https://app.keeperhub.com (Settings → Developer → API keys).
# Keys use the kh_ prefix. Send as: Authorization: Bearer kh_...
KEEPERHUB_API_KEY=

# HMAC secret for the append-only CHP audit ledger.
# Replace before any real funds. Demo default is used only when unset.
AUDIT_LEDGER_KEY=demo-ledger-key-not-for-production

# Preferred testnet for DoraHacks. Base Sepolia is the default.
# Alternatives: 11155111 (Ethereum Sepolia)
KEEPERHUB_CHAIN_ID=84532

# KeeperHub REST + MCP surfaces (documented defaults).
KEEPERHUB_API_BASE=https://app.keeperhub.com
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# Settlement recipient for compiled testnet transfers.
# Use all-lowercase or a valid EIP-55 checksum (KeeperHub rejects bad mixed-case).
KEEPERHUB_RECIPIENT_ADDRESS=0x000000000000000000000000000000000000dead

# Native amount (human units) broadcast on the testnet transfer path.
# CHP still evaluates the Almanak notional (USD), not this settlement size.
KEEPERHUB_TRANSFER_AMOUNT=0.001

# If true, convert Almanak amount_usd through the snapshot price into the
# transfer amount. Default false so the demo stays a cheap testnet proof.
KEEPERHUB_USE_INTENT_AMOUNT=false

# Policy file
CHP_POLICY_PATH=./policy.example.yaml
